# Enter actual values in the Dokploy environment editor.
# This profile selects the approved HTML pipeline for new jobs.
PDF_RENDER_MODE=html_template
PDF_PIPELINE_VERSION=canonical_v1
PDF_REVIEW_POLICY=always
PDF_MEDIA_AUTO_CATALOG={}
PDF_DATA_DIR=/app/var
PDF_PUBLIC_BASE_URL=https://REPLACE_WITH_PREMIUM_HOSTNAME
PDF_HOST_PORT=18081
PDF_WORKER_TIMEOUT_SECONDS=600
PDF_API_TOKENS={}
POSTGRES_PASSWORD=
DATABASE_URL=
OPENAI_API_KEY=
PDF_AI_DOCUMENT_BUDGET_USD=0.15
PDF_AI_DAILY_BUDGET_USD=0.30
PDF_MEDIA_MODE=search
PDF_MEDIA_OPENAI_SEARCH_ENABLED=true
PDF_MEDIA_SEARCH_RESERVE_USD=0.05
PDF_MEDIA_SEARCH_DAILY_BUDGET_USD=0.10
# Configure exact Bubble CDN hosts per tenant before requiring the legacy URL.
PDF_LEGACY_PDF_HOSTS={}
PDF_REQUIRE_LEGACY_PDF_URL=false
