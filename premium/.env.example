# Examples only. Generate real local/deploy secrets with scripts/setup_env.py.
PDF_DATA_DIR=var
DATABASE_URL=sqlite:///var/state.db
PDF_API_TOKENS={}
PDF_REVIEW_POLICY=always
# validated_auto requires html_template + canonical_v1 + an authorized safety PDF URL.
# Exact preauthorized photographs by tenant/place are preferred before discovery.
PDF_MEDIA_AUTO_CATALOG={}
# Empty: validated_auto + search uses credited matching-source photos.
# Set approved_only to restrict automatic delivery to explicitly approved assets.
PDF_MEDIA_AUTO_USE_POLICY=
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=50
PDF_RENDER_DPI=240
PDF_WORKER_TIMEOUT_SECONDS=7200
PDF_RENDER_MODE=openai_images
# Explicit opt-in for provider-independent data -> cards -> measured pagination.
# Requires PDF_RENDER_MODE=html_template. Existing records retain their pipeline.
PDF_PIPELINE_VERSION=legacy
PDF_MAX_OUTPUT_PAGES=100
# Exact allowed standard-PDF hostnames per organization, never arbitrary URLs.
# Example only: {"difftravel":["files.example.com"]}
PDF_LEGACY_PDF_HOSTS={}
PDF_REQUIRE_LEGACY_PDF_URL=false
# Required for the HTML PDF's original-download button. Separate premium API origin.
# Production: HTTPS origin; local tests only: http://127.0.0.1:8004
PDF_PUBLIC_BASE_URL=
PDF_ORIGINAL_LINK_TTL_DAYS=365
# Explicit premium alternative: html_template (no image-generation calls per page).
# Install the worker browser with: python -m playwright install --with-deps chromium
# Local Windows alternative, only if installed: PDF_HTML_BROWSER_CHANNEL=chrome
PDF_MEDIA_MODE=brand
# For automatic photo discovery in HTML mode: PDF_MEDIA_MODE=search
PDF_MEDIA_SOURCES_FILE=assets/media/sources.json
# Optional search providers. Leave blank to use verified websites/source URLs only.
BRAVE_SEARCH_API_KEY=
PEXELS_API_KEY=
# Optional direct image search. Official site first, then one bounded search.
# Secrets stay on the server. Consumes at most one search credit per lookup.
SERPAPI_KEY=
# Optional general discovery using the existing OpenAI account; paid, no new SaaS.
# Disabled by default. One tool call/search, max 1200 output tokens, no retries.
PDF_MEDIA_OPENAI_SEARCH_ENABLED=false
PDF_MEDIA_SEARCH_RESERVE_USD=0.05
# Separate global-day reservation ceiling, in addition to the shared AI budgets.
PDF_MEDIA_SEARCH_DAILY_BUDGET_USD=0.10
# Google Maps reference links need no key. Google photo import into PDFs is disabled.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1536x2176
# Lower-cost tested profile: gpt-image-2 / medium / 1024x1536.
# One-page preview passed; see docs/TESTE_GPT2_MEDIUM_2026-10-27.md.
# Alternative explicitly tested: gpt-image-1-mini / medium / 1024x1536.
# Mini medium was rejected for dense document text; see its test report.
PDF_AI_MAX_PAGES=16
PDF_AI_REQUEST_TIMEOUT_SECONDS=180
# Estimates reserved transactionally, not a hard limit on the provider's invoice.
PDF_AI_DOCUMENT_BUDGET_USD=12
PDF_AI_DAILY_BUDGET_USD=24
# Deployment may pin a complete tested registry image, preferably by digest:
# PDF_IMAGE_REF=registry.example.com/difftravel-pdf-premium@sha256:REPLACE_WITH_TESTED_DIGEST
# For Docker, setup_env.py --docker also generates POSTGRES_PASSWORD and its URL.
# For local Windows OCR, configure the installed binary and a por+eng tessdata directory:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/path/to/tessdata
# Production generation uses OpenAI in the worker. Never commit real keys.
# PDF_RENDER_MODE=local exists only for synthetic tests/legacy pilot diagnostics.
